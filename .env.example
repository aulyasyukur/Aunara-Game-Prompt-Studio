# GEMINI_API_KEY: Required for server-side Gemini AI API calls (via /api/test-prompt-game).
# AI Studio automatically injects this at runtime from Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Secret key used ONLY on the backend to sign auth session tokens (HMAC-SHA256).
# Leave unset to auto-generate a secure 256-bit secret locally inside .aunara-data/session.secret.
SESSION_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
